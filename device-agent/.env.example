# MCPtoAI Manager — local preferences only.
# Users do NOT create their own Auth0 application, tunnel, or public server.
# Provider API keys and OAuth refresh tokens are stored in the OS Keychain, never here.

# --- Model provider ---
MCPTOAI_PROVIDER=anthropic
MCPTOAI_MODEL=claude-sonnet-5
# MCPTOAI_OPENAI_BASE_URL=http://localhost:11434/v1

# --- Tool boundaries ---
MCP_ALLOWED_ROOTS=~/Desktop:~/Documents:~/Downloads
MCPTOAI_ENABLE_SHELL=false
MAX_OUTPUT_CHARS=64000
DEFAULT_CMD_TIMEOUT=300
MCPTOAI_MAX_STEPS=15

# --- MCPtoAI production identity/service configuration ---
# These are product/deployment settings, not per-user Auth0 setup.
AUTH0_DOMAIN=YOUR_MCPTOAI_TENANT.eu.auth0.com
AUTH0_DEVICE_CLIENT_ID=YOUR_MCPTOAI_NATIVE_APP_CLIENT_ID
AUTH0_AUDIENCE=https://api.mcptoai.com
MCPTOAI_SERVER_URL=https://api.mcptoai.com

# Optional development/diagnostic overrides only.
# MCPTOAI_RELAY_URL=wss://api.mcptoai.com/ws/device/DEVICE_UUID/
MCPTOAI_RECONNECT_MAX_SECONDS=30
